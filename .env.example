# Root reference for every service's environment variables.
# In development each app also keeps its own .env (apps/api/.env, apps/web/.env),
# copied from apps/api/.env.example and apps/web/.env.example respectively.

# ---- apps/api -------------------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Native PostgreSQL install (no Docker). Update the password to match the one
# you set for the postgres superuser during installation.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_recommender

CV_PARSER_BASE_URL=http://localhost:8000
CV_PARSER_TIMEOUT_MS=15000

CV_MAX_FILE_SIZE_MB=10

# ---- apps/web ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
