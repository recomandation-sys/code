{
  "name": "@job-recommender/web",
  "version": "0.1.0",
  "private": true,
  "description": "Candidate CV upload & review UI (React + TS + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --dry",
